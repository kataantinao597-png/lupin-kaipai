# 鲁品开拍 - 环境变量示例
# 复制为 .env 后填入真实值：cp .env.example .env
# ⚠️ .env 绝不提交到 git（含真实密钥）

# ---------- 服务 ----------
# 监听端口（CloudBase 会自动注入 PORT）
PORT=8080
# 运行环境：development / staging / production
ENV=production

# ---------- 数据库 ----------
# 生产用 PostgreSQL；留空则用 SQLite（backend/data/lupin.db）
# 格式：postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=
# 兼容旧变量（仅 DATABASE_URL 未设置时生效）
LUPIN_DB_PATH=
# 生产必须设为 0，并用 alembic upgrade head 做迁移
LUPIN_DB_AUTO_CREATE=0

# ---------- 认证 ----------
# JWT 签名密钥（生产必须设置，至少 32 位随机字符串）
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
LUPIN_JWT_SECRET=
# HTTPS 生产环境设为 1（Cookie 加 Secure 标记）
LUPIN_COOKIE_SECURE=1
# 密码重置调试（生产保持 0；设 1 时重置接口会返回 token，仅联调用）
LUPIN_AUTH_DEBUG=0

# ---------- AI 模型 ----------
# OpenAI 兼容接口地址（deepkey 中转站）
LUPIN_API_BASE=https://deepkey.top/v1
# 模型 Key（⚠️ 只从环境变量注入，不写代码/镜像/日志）
LUPIN_API_KEY=
# 默认模型
LUPIN_MODEL=gpt-6-luna

# ---------- 媒体存储（S8.1/S8.2） ----------
# 存储后端：local（默认，文件落 backend/media_files/）或 s3（需 boto3）
LUPIN_STORAGE_BACKEND=local
# 本地存储根目录（默认 <项目>/backend/media_files）
LUPIN_MEDIA_DIR=
# 签名下载 URL 的 HMAC 密钥（生产必须设置，至少 32 位随机字符串；
# 未设置则进程内随机，重启后旧签名全部失效）
LUPIN_MEDIA_SIGN_SECRET=
# S3 后端配置（LUPIN_STORAGE_BACKEND=s3 时用，需 pip install boto3）
LUPIN_S3_BUCKET=
LUPIN_S3_ENDPOINT=
LUPIN_S3_REGION=auto
LUPIN_S3_ACCESS_KEY=
LUPIN_S3_SECRET_KEY=
